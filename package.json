{
  "name": "x-video-downloader-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-ready Twitter / X Video Downloader PWA and Playwright acceptance test suite",
  "scripts": {
    "build:assets": "node scripts/build-assets.js",
    "test": "playwright test --grep-invert @live",
    "test:desktop": "playwright test --project=desktop-chromium --grep-invert @live",
    "test:mobile": "playwright test --project=mobile-chromium --grep-invert @live",
    "test:live": "playwright test --grep @live",
    "test:headed": "playwright test --headed --grep-invert @live",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.52.0",
    "tailwindcss": "^3.4.19"
  }
}
